@using System.Dynamic
@using Domain.Enum

@code {

    #region --Variables

    [Parameter] public string? Name { get; set; }
    [Parameter] public Dictionary<string, List<ExpandoObject>> Columns { get; set; } = new();
    [Parameter] public EventCallback<string> OnAddCard { get; set; }
    [Parameter] public bool IsLoading { get; set; } = true;
    private ExpandoObject? _draggedCard;
    private string? _dragSourceColumn;

    #endregion

    #region --Base

    private void HandleDragStart(ExpandoObject card, string columnName)
    {
        _draggedCard = card;
        _dragSourceColumn = columnName;
    }

    private async Task HandleDrop(string targetColumn)
    {
        if (_draggedCard != null && _dragSourceColumn != null && _dragSourceColumn != targetColumn)
        {
            Columns[_dragSourceColumn].Remove(_draggedCard);

            Columns[targetColumn].Add(_draggedCard);

            var columnKeys = Columns.Keys.ToList();
            int targetIndex = columnKeys.IndexOf(targetColumn);

            if (targetIndex >= 0)
            {
                if (_draggedCard is IDictionary<string, object> cardDictionary && cardDictionary.ContainsKey("Id"))
                {
                    var cardId = (Guid)cardDictionary["Id"];

                    KanbanStatusCard newStatus = (KanbanStatusCard)targetIndex;
                    await UpdateCardStatus(newStatus, cardId);
                }
            }

            _draggedCard = null;
            _dragSourceColumn = null;

            StateHasChanged();
        }
    }

    private async Task AddCardToColumn(string columnName)
    {
        if (OnAddCard.HasDelegate)
        {
            await OnAddCard.InvokeAsync(columnName);
        }
    }

    private async Task UpdateCardStatus(KanbanStatusCard sourceColumn, Guid cardId)
    {
        await _KanbanRepository.ChangeStatusCard(new(
            cardId,
            sourceColumn
        ));
    }

    private void HandleAddNewCard() =>
        navigationManager.NavigateTo("/RegisterCardKanban");

    private void HandleEditCard(IDictionary<string, object> card)
    {
        var id = (Guid)card["Id"];
        navigationManager.NavigateTo($"/UpdateCardKanban/{id}");
    }

    #endregion

}


<div class="flex space-x-4 p-4 bg-gray-100 min-h-screen">
    @if (IsLoading)
    {
        <div class="text-center w-full">
            <div>
                <div class="skeleton h-8 w-1/3 my-2 bg-gray-300"></div>
                <div class="skeleton h-6 w-1/2 my-2 bg-gray-300 mx-auto"></div>
                <div class="skeleton h-8 w-1/4 mt-4 bg-gray-300 mx-auto"></div>
            </div>
        </div>
    }
    else
    {
        @foreach (var column in Columns)
        {
            <div class="bg-white rounded-md p-4 w-full"
                 ondragover="event.preventDefault();"
                 @ondrop="() => HandleDrop(column.Key)">
                <div class="flex justify-between pb-2 mb-4 border-b border-gray-300">
                    <div class="font-semibold">@column.Key</div>
                    <button class="bg-green-500 text-white text-sm py-1 px-2 rounded hover:bg-green-600"
                            @onclick="HandleAddNewCard">
                        + Add
                    </button>
                </div>

                @if (column.Value.Count == 0)
                {
                    <div class="text-gray-500 text-center italic">Sem cartões nesta coluna</div>
                }
                else
                {
                    @foreach (var card in column.Value)
                    {
                        <div class="bg-gray-100 shadow-sm p-3 mb-4 rounded-md cursor-move"
                             draggable="true"
                             @ondblclick="() => HandleEditCard(((IDictionary<string, object>)card))"
                             @ondragstart="() => HandleDragStart(card, column.Key)">
                            <div class="font-bold text-gray-700">@(((IDictionary<string, object>)card)["Title"])</div>
                            <div
                                class="text-sm text-gray-600">@(((IDictionary<string, object>)card)["Description"])</div>
                        </div>
                    }
                }
            </div>
        }
    }
</div>
