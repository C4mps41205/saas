@page "/Users"
@using System.Dynamic
@using Application.Dto
@using Application.Dto.Response
@using CRM_SAAS.Models

@code {

    #region --Variables

    List<GridCells> _columns;
    List<ExpandoObject> _rows = new();
    public bool IsLoading { get; set; } = true;
    public int Page { get; set; }
    public int PageSize { get; set; }
    public int TotalPages { get; set; }

    #endregion

    #region --Base

    protected override async Task OnInitializedAsync()
    {
        _columns = new List<GridCells>
        {
            new() { Collumn = "Name" },
            new() { Collumn = "Simultaneous Services" },
            new()
            {
                Collumn = "Actions",
                Render = row =>
                    @<ButtonDefault
                        Id="Edit"
                        Label="Edit"
                        Name="Edit"
                        ValueChangedCallback="r => ButtonClickedCallbackEdit(row)"
                    />
            }
        };

        _EmployeeRepository.OnEmployeesCreated += async (_) =>
        {
            await GetAllUsers();
            StateHasChanged();
        };

        _EmployeeRepository.OnEmployeeDeleted += async (_) =>
        {
            await GetAllUsers();
            StateHasChanged();
        };

        await _EmployeeRepository.InitializeConnectionHubEmployee();
        await GetAllUsers();
    }

    #endregion

    #region --Methods

    async Task GetAllUsers()
    {
        PaginationDefault<GetEmployeeResponse> result = await _EmployeeRepository.GetPaginatedEmployees(new(1, 10, 1));

        Page = result.Page;
        PageSize = result.PageSize;
        TotalPages = result.TotalPages;
        _rows = result.Data
            .Select(Employee =>
            {
                dynamic expando = new ExpandoObject();
                var dict = (IDictionary<string, object>)expando;

                dict["Name"] = Employee.Name;
                dict["SimultaneousServices"] = Employee.SimultaneousServices;
                dict["Actions"] = "";

                return (ExpandoObject)expando;
            })
            .ToList();
        IsLoading = false;

        StateHasChanged();
    }

    private Task ButtonClickedCallback()
    {
        navigationManager.NavigateTo("/RegisterEmployee");
        return Task.CompletedTask;
    }

    private Task ButtonClickedCallbackEdit(dynamic row)
    {
        navigationManager.NavigateTo($"/UpdateEmployee/{row.Id}");
        return Task.CompletedTask;
    }

    #endregion

}

<CrudDefaultLayout
    Title="Employee"
    ButtonClicked="ButtonClickedCallback"
    GridCells="_columns"
    IsLoading="IsLoading"
    Data="_rows"
    Page="Page"
    PageSize="PageSize"
    TotalPages="TotalPages"
/>