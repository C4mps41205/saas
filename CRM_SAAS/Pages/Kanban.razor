@page "/Kanban"

@code {

    IEnumerable<string> collumns = new[]
    {
        "Criado",
        "Em processo",
        "Em teste",
        "Finalizado",
    };

}

<div class="flex justify-evenly gap-3" style="height: 100%">
    @foreach (var collumn in collumns)
    {
        <CollumnKanban
            Name="@collumn"
        />
    }
</div>