@page "/Clients"
@using System.Dynamic
@using Application.Dto
@using Application.Dto.Response
@using CRM_SAAS.Models

@code {

    #region --Variables

    List<GridCells> _columns;
    List<ExpandoObject> _rows = new();
    public bool IsLoading { get; set; } = true;
    public int Page { get; set; }
    public int PageSize { get; set; }
    public int TotalPages { get; set; }

    #endregion

    #region --Base

    protected override async Task OnInitializedAsync()
    {
        _columns = new List<GridCells>
        {
            new() { Collumn = "Phone" },
            new() { Collumn = "Name" },
            new() { Collumn = "CpfCnpj" },
            new() { Collumn = "PersonType" },
            new() { Collumn = "Email" },
            new() { Collumn = "BirthDate" },
            new() { Collumn = "State" },
            new() { Collumn = "City" },
            new() { Collumn = "Cep" },
            new() { Collumn = "Number" },
            new() { Collumn = "Neighborhood" },
            new() { Collumn = "Complement" },
            new()
            {
                Collumn = "Actions",
                Render = row =>
                    @<ButtonDefault
                        Id="Edit"
                        Label="Edit"
                        Name="Edit"
                        ValueChangedCallback="r => ButtonClickedCallbackEdit(row)"
                    />
            }
        };

        _ClientsRepository.OnClientsCreated += async (_) =>
        {
            await GetAllClients();
            StateHasChanged();
        };

        _ClientsRepository.OnClientDeleted += async (_) =>
        {
            await GetAllClients();
            StateHasChanged();
        };

        await _ClientsRepository.InitializeConnectionHubClient();
        await GetAllClients();
    }

    #endregion

    #region --Methods

    async Task GetAllClients()
    {
        PaginationDefault<GetClientResponse> result = await _ClientsRepository.GetPaginatedClients(new(1, 10, 1));

        Page = result.Page;
        PageSize = result.PageSize;
        TotalPages = result.TotalPages;
        _rows = result.Data
            .Select(client =>
            {
                dynamic expando = new ExpandoObject();
                var dict = (IDictionary<string, object>)expando;

                dict["Id"] = client.Id;
                dict["Phone"] = client.Phone;
                dict["Name"] = client.Name;
                dict["CpfCnpj"] = client.CpfCnpj;
                dict["PersonType"] = client.PersonType;
                dict["Email"] = client.Email;
                dict["BirthDate"] = client.BirthDate;
                dict["State"] = client.State;
                dict["City"] = client.City;
                dict["Cep"] = client.Cep;
                dict["Number"] = client.Number;
                dict["Neighborhood"] = client.Neighborhood;
                dict["Complement"] = client.Complement;
                dict["Actions"] = "";

                return (ExpandoObject)expando;
            })
            .ToList();
        IsLoading = false;

        StateHasChanged();
    }

    private Task ButtonClickedCallback()
    {
        navigationManager.NavigateTo("/RegisterClient");
        return Task.CompletedTask;
    }

    private Task ButtonClickedCallbackEdit(dynamic row)
    {
        navigationManager.NavigateTo($"/UpdateClient/{row.Id}");
        return Task.CompletedTask;
    }

    #endregion

}

<CrudDefaultLayout
    Title="Users"
    ButtonClicked="ButtonClickedCallback"
    GridCells="_columns"
    IsLoading="IsLoading"
    Data="_rows"
    Page="Page"
    PageSize="PageSize"
    TotalPages="TotalPages"
/>